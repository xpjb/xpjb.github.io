+
+fn audit_snapshot(root:&Path, output:&Path, report:&CanonicalReport)->Result<()> {
+    for package in &report.packages {
+        for relative in &package.output_files {
+            let destination=output.join(relative);
+            fs::create_dir_all(destination.parent().unwrap())?;
+            fs::copy(root.join(relative),destination)?;
+        }
+    }
+    fs::write(output.join("phase-report.json"),serde_json::to_vec_pretty(report)?)?;
+    Ok(())
